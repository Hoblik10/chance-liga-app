# Šablona pro secrets – tento soubor se commituje, skutečné hodnoty NE.
#
# Použití:
#   1) Zkopíruj tento soubor jako .streamlit/secrets.toml
#   2) Doplň skutečné hodnoty
#
# Na Streamlit Cloud se hodnoty nezadávají souborem, ale v:
#   App settings -> Secrets
#
# Pro automatické páteční hlášení přes GitHub Actions zadej stejné klíče
# v GitHubu: Settings -> Secrets and variables -> Actions.

TELEGRAM_TOKEN = "sem-vloz-token-z-botfather"
TELEGRAM_CHAT_ID = "sem-vloz-svoje-chat-id"

# TheSportsDB – rozpis, výsledky, odložené zápasy, tabulka, poháry.
# Klíč "123" je veřejný testovací a funguje bez registrace, takže aplikace
# jede rovnou po naklonování. Registrací na https://www.thesportsdb.com/
# získáš vlastní klíč s vyššími limity.
SPORTSDB_KEY = "123"

# Sezóna v zápisu TheSportsDB (rozsah let).
SEZONA = "2026-2027"

# API-Football – volitelné živé kurzy 1/X/2 na Chance Ligu.
# Zdarma na https://dashboard.api-football.com/ (100 dotazů denně).
# Tipsport v té sadě sázkovek není; typicky Bet365 / Unibet / 1xBet.
API_FOOTBALL_KEY = ""
